def row3AtomList : List RatAtom := row3AtomVector.toList

def row3 : RatRow where
  a0 := 0.5989667792593105
  a1 := 0.1926097320089688
  a2 := -0.33305794845649145
  atoms := row3AtomList

def row3Atoms : Fin 400 → RatAtom := row3AtomVector.get

def row3DualAtoms : Fin 400 → ErdosMinimum.DualAtom :=
  fun i ↦ (row3Atoms i).toDual

theorem row3_vector_count : row3AtomVector.size = 400 := by rfl

set_option maxRecDepth 100000 in
theorem row3_atom_count : row3.atoms.length = 400 := by rfl

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem row3_alpha_pos (i : Fin 400) : 0 < (row3Atoms i).alpha := by
  revert i
  decide +kernel

theorem row3_dual_alpha_pos (i : Fin 400) :
    0 < (row3DualAtoms i).alpha := by
  simpa only [row3DualAtoms, RatAtom.toDual] using
    (Rat.cast_pos (K := ℝ)).2 (row3_alpha_pos i)

/-- Atom count indexed by the certificate row. -/
def atomCount : Fin 4 → ℕ
  | 0 => 1090
  | 1 => 1098
  | 2 => 400
  | 3 => 400

/-- The complete exact-rational certificate row. -/
def row : Fin 4 → RatRow
  | 0 => row0
  | 1 => row1
  | 2 => row2
  | 3 => row3

/-- Exact atom data, with the row-dependent count in its type. -/
def atoms : (row : Fin 4) → Fin (atomCount row) → RatAtom
  | 0 => row0Atoms
  | 1 => row1Atoms
  | 2 => row2Atoms
  | 3 => row3Atoms

/-- Analytic atom data, with exact rational values coerced to reals. -/
def dualAtoms : (row : Fin 4) → Fin (atomCount row) → ErdosMinimum.DualAtom
  | 0 => row0DualAtoms
  | 1 => row1DualAtoms
  | 2 => row2DualAtoms
  | 3 => row3DualAtoms

/-- Every alpha in every row is strictly positive. -/
theorem alpha_pos (row : Fin 4) (i : Fin (atomCount row)) :
    0 < (atoms row i).alpha := by
  fin_cases row
  exact row0_alpha_pos i
  exact row1_alpha_pos i
  exact row2_alpha_pos i
  exact row3_alpha_pos i

/-- The real-valued analytic view preserves strict alpha positivity. -/
theorem dual_alpha_pos (row : Fin 4) (i : Fin (atomCount row)) :
    0 < (dualAtoms row i).alpha := by
  fin_cases row
  exact row0_dual_alpha_pos i
  exact row1_dual_alpha_pos i
  exact row2_dual_alpha_pos i
  exact row3_dual_alpha_pos i

end ErdosMinimum.CertificateData
